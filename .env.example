# ==================================================
# COMIKS X - PROFESSIONAL AI VIDEO PRODUCTION STUDIO
# Environment Variables & Provider Configuration
# ==================================================

# Canonical Production Site URL for Auth Redirects & PWA
# 1. In Vercel Project Settings -> Environment Variables: NEXT_PUBLIC_SITE_URL=https://comiks-x.vercel.app
# 2. In Supabase Dashboard -> Authentication -> URL Configuration:
#    - Site URL: https://comiks-x.vercel.app
#    - Redirect URLs: https://comiks-x.vercel.app/** and http://localhost:3000/**
NEXT_PUBLIC_SITE_URL=https://comiks-x.vercel.app
NEXT_PUBLIC_APP_URL=https://comiks-x.vercel.app

# ==========================================
# 1. SUPABASE AUTH, DATABASE & STORAGE
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# SERVER-SIDE ONLY: Never prefix with NEXT_PUBLIC_ or import in client components.
# Required for immediate, unconfirmed-email user creation via /api/auth/signup using auth.admin.createUser.
# Add to Vercel Environment Variables (Production & Preview).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ==========================================
# 2. AI GENERATION PROVIDER ADAPTERS
# ==========================================
# Active Video Provider: fal | replicate | luma | runway | kling
ACTIVE_VIDEO_PROVIDER=fal

# Fal.ai API key (FLUX keyframes + Minimax/Wan 2.1 video)
FAL_KEY=

# Replicate API token (Wan 2.1 I2V / Luma Ray 2)
REPLICATE_API_TOKEN=

# Additional Providers
LUMA_API_KEY=
RUNWAY_API_KEY=
KLING_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# ==========================================
# 3. OFF-VERCEL RENDER WORKER (FFmpeg on Modal/Railway/Fly.io)
# ==========================================
# NEVER execute heavy FFmpeg video exports directly inside serverless Vercel requests.
# Deploy the standalone FFmpeg worker to Railway, Modal, or Fly.io and set the URL below:
RENDER_WORKER_URL=https://render-worker.comiks-x.internal
RENDER_WORKER_SECRET=your_secure_worker_hmac_secret

# ==========================================
# 4. BACKGROUND QUEUE & WEBHOOK SIGNATURES
# ==========================================
INNGEST_SIGNING_KEY=
TRIGGER_API_KEY=
WEBHOOK_SECRET=

# ==========================================
# 5. SPENDING CAPS & ENVIRONMENT
# ==========================================
DAILY_BUDGET_LIMIT_USD=50.00
PORT=3000
NODE_ENV=production
