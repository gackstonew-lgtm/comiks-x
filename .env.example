# ==================================================
# COMIKS X - AI COMIC ANIMATION STUDIO
# Environment Variables & Provider Configuration
# ==================================================

# Active Video Provider: luma | runway | kling | fal | sora
ACTIVE_VIDEO_PROVIDER=luma

# AI Video Providers
LUMA_API_KEY=
RUNWAY_API_KEY=
KLING_API_KEY=
FAL_KEY=
OPENAI_API_KEY=

# Character Speech & Voice Synthesis (ElevenLabs or OpenAI TTS)
ELEVENLABS_API_KEY=

# Story & Script Decomposition LLM (Google Gemini or OpenAI)
GEMINI_API_KEY=

# Supabase Backend & Authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Canonical Production Site URL for Auth Redirects & PWA
# IMPORTANT:
# 1. In Vercel Project Settings -> Environment Variables, set NEXT_PUBLIC_SITE_URL=https://comiks-x.vercel.app
# 2. In Supabase Dashboard -> Authentication -> URL Configuration:
#    - Site URL: https://comiks-x.vercel.app
#    - Redirect URLs: https://comiks-x.vercel.app/** and http://localhost:3000/**
NEXT_PUBLIC_SITE_URL=https://comiks-x.vercel.app

# Storage & Deployment
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://comiks-x.vercel.app
DAILY_BUDGET_LIMIT_USD=50.00
